    <div class="modal-dialog">
      <div class="modal-header">
        <div>
          <h3 id="pdf-modal-title" class="modal-title">Exportar Plantilla PDF a Escala 1:1</h3>
          <p class="modal-subtitle">Selecciona hojas específicas o un rango rectangular para imprimir al 100%.</p>
        </div>
        <button id="btn-pdf-cancel-export" type="button" class="btn btn-secondary btn-sm">Cerrar</button>
