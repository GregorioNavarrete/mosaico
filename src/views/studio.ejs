          <span class="field-label" style="margin: 0;">Mapa interactivo de hojas</span>
          <div style="display: flex; gap: 0.4rem;">
            <button id="btn-pdf-select-all" type="button" class="btn btn-secondary btn-sm">Seleccionar todas</button>
